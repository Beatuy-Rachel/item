# ============================================
# 项目配置文件
# 使用方法：复制此文件为 .env，然后修改对应的值
# ============================================

# GitHub 仓库信息（用于拉取 Docker 镜像）
# 格式：用户名/仓库名，必须全小写
GITHUB_REPOSITORY=beatuy-rachel/item

# GHCR 登录信息（部署时需要）
GHCR_USERNAME=your-github-username
GHCR_TOKEN=your-github-personal-access-token

# ============================================
# 数据库配置
# ============================================
# MySQL root 用户密码
DB_ROOT_PASSWORD=change_me_root_password

# 数据库名称
DB_NAME=item_tracker

# 数据库用户名
DB_USER=root

# 数据库密码
DB_PASSWORD=change_me_root_password

# ============================================
# 后端配置
# ============================================
# JWT 密钥（请修改为随机字符串）
JWT_SECRET=please_change_this_to_a_random_string

# ============================================
# 前端配置
# ============================================
# Web 服务端口
WEB_PORT=8080

# 时区
TZ=Asia/Shanghai
