FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache tzdata \
  && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
  && echo "Asia/Shanghai" > /etc/timezone

COPY server/package.json ./
COPY server/package-lock.json* ./

RUN npm ci --production

COPY server/ ./

EXPOSE 3001

CMD ["node", "index.js"]
